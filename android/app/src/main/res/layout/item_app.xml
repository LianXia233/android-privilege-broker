<?xml version="1.0" encoding="utf-8"?>
<!-- 逐应用授权行：名称 / 包名 / 系统徽章 / 开关 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/pb_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemAppName"
            style="@style/PbText.Subheadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/itemAppPkg"
            style="@style/PbText.Caption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="middle"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemAppTag"
        style="@style/PbText.Caption2"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/pb_chip_idle"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <io.github.lianxia233.privbroker.PrismSwitch
        android:id="@+id/itemAppSwitch"
        android:layout_width="wrap_content"
        android:layout_height="44dp" />
</LinearLayout>
