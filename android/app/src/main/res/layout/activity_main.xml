<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pbSurfacePage">

    <!-- 四个页面常驻，切换只做可见性与位移动画（PageSwitcher） -->
    <io.github.lianxia233.privbroker.PageSwitcher
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮导航 Dock：62dp 胶囊，左右 21dp；底部安全区由 dockHost 的内边距补齐 -->
    <FrameLayout
        android:id="@+id/dockHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <io.github.lianxia233.privbroker.NavigationDock
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="21dp"
            android:layout_marginEnd="21dp"
            android:layout_marginBottom="21dp" />
    </FrameLayout>
</FrameLayout>
