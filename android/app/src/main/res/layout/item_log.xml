<?xml version="1.0" encoding="utf-8"?>
<!-- 安装记录条目：FlClash 卡片行（状态点 + 标题/元信息 + 结果胶囊） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/pb_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/itemDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top"
            android:layout_marginTop="6dp"
            android:background="@drawable/pb_dot_idle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemTitle"
                style="@style/PbText.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/itemMeta"
                style="@style/PbText.Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemBadge"
            style="@style/PbText.Caption2"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pb_chip_idle"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemDetail"
        style="@style/PbText.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/pb_block"
        android:ellipsize="end"
        android:maxLines="3"
        android:padding="10dp"
        android:textColor="?attr/pbTextSecondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemToggle"
        style="@style/PbText.Caption2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/log_expand"
        android:textColor="?attr/pbPrimary"
        android:visibility="gone" />
</LinearLayout>
