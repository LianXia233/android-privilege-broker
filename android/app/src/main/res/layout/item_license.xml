<?xml version="1.0" encoding="utf-8"?>
<!-- 许可条目：名称 + 许可徽章 + 用途说明，整行可点击跳转上游仓库 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/licenseRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pb_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/licenseName"
            style="@style/PbText.Subheadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/licenseBadge"
            style="@style/PbText.Caption2"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pb_chip_idle"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/licenseUse"
        style="@style/PbText.Caption2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
</LinearLayout>
