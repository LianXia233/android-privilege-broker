<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pbSurfacePage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/logsHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/PbText.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_logs" />

            <ImageView
                android:id="@+id/btnLogShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/pb_pill_soft"
                android:contentDescription="@string/logs_share_title"
                android:padding="9dp"
                android:src="@drawable/ic_action_share"
                android:tint="?attr/pbTextPrimary" />

            <ImageView
                android:id="@+id/btnLogClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pb_pill_soft"
                android:contentDescription="@string/logs_cleared"
                android:padding="9dp"
                android:src="@drawable/ic_action_trash"
                android:tint="?attr/pbTextPrimary" />
        </LinearLayout>

        <io.github.lianxia233.privbroker.SegmentedControl
            android:id="@+id/segLogs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/logList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="140dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/logEmpty"
                style="@style/PbText.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/logs_empty"
                android:textColor="?attr/pbTextMuted" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
