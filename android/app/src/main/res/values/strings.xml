    <string name="about_version">版本 %1$s</string>
    <string name="about_desc">基于 Rust 核心与自主特权代理实现的 Android 静默安装器。应用内可完成无线调试启用与配对：发现本机无线调试服务、在通知栏输入 6 位配对码、经 TLS 与密钥交换注册公钥，随后通过 ADB TLS 通道以 shell 身份启动特权代理，全程不需要电脑或 USB。应用与代理之间通过长度前缀帧协议通信，含挑战响应认证、会话隔离、超时与撤销。安装包由调用方交给本应用后，在后台线程经代理执行 pm install，全程不弹确认框、不跳转应用界面，进度与结果通过通知与安装日志反馈。无线调试配对涉及设备端实现差异，该链路尚待真机验证。</string>
    <string name="about_repo_label">开源仓库</string>
    <string name="about_repo_url">https://github.com/LianXia233/android-privilege-broker</string>
    <string name="about_repo_hint">点击在浏览器中打开，可查看源码、提交记录与版本发布</string>
    <string name="about_dev_label">开发者</string>
    <string name="about_dev_name">LianXia233 · 开发与维护</string>
    <string name="about_license_label">开源许可与致谢</string>
