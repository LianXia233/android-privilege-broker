<?xml version="1.0" encoding="utf-8"?>
<!--
  配色令牌：布局 / drawable 从 @color/pb_* 迁移到 ?attr/pb* 后，
  才能在运行时通过 setTheme() 切换色板（主题色、纯黑模式）。
-->
<resources>
    <attr name="pbPrimary" format="color" />
    <attr name="pbOnPrimary" format="color" />
    <attr name="pbPrimaryContainer" format="color" />
    <attr name="pbOnPrimaryContainer" format="color" />

    <attr name="pbSurfacePage" format="color" />
    <attr name="pbSurfaceCard" format="color" />
    <attr name="pbSurfaceBlock" format="color" />
    <attr name="pbSurfaceInset" format="color" />
    <attr name="pbSurfaceFloating" format="color" />

    <attr name="pbTextPrimary" format="color" />
    <attr name="pbTextSecondary" format="color" />
    <attr name="pbTextMuted" format="color" />
    <attr name="pbDivider" format="color" />

    <attr name="pbSuccess" format="color" />
    <attr name="pbError" format="color" />
    <attr name="pbWarning" format="color" />
</resources>
