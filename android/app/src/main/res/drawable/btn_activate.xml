<?xml version="1.0" encoding="utf-8"?>
<!-- 主 CTA：激活服务。比普通主按钮更醒目的三段渐变。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/pbRipple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/pbPrimary"
                android:centerColor="?attr/pbPrimaryContainer"
                android:endColor="?attr/pbPrimary"
                android:angle="0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
