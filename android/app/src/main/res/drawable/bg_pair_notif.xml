<?xml version="1.0" encoding="utf-8"?>
<!-- 激活按钮旁的高亮「通知栏输码」入口：暖色渐变 + 描边，与蓝色激活按钮形成对比。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FFF7E8"
        android:centerColor="#FFEBC8"
        android:endColor="#FFDCA6"
        android:angle="0" />
    <stroke
        android:width="1.5dp"
        android:color="#F5A623" />
    <corners android:radius="16dp" />
</shape>
