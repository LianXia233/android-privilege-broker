<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色主题：配色由 values-night/colors.xml 提供，这里只切系统栏与 Material 基调 -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHighlight">@color/ripple_soft</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
